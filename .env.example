# Copie este arquivo para .env e substitua os valores de exemplo.
# Nunca versione o .env ou credenciais reais.

PROJECT_NAME="Esports API"

# Use development somente no desenvolvimento local: habilita rotas de debug.
ENVIRONMENT=production

# Gere uma chave aleatoria e substitua este valor antes de iniciar a API.
API_ACCESS_KEY="SUBSTITUA_POR_UMA_CHAVE_ALEATORIA"

# Opcional: chave exclusiva do servidor para POST /teams/ e /matches/sync-now.
# Nunca coloque esta chave no Android. Vazio desabilita essas operacoes.
ADMIN_API_KEY=""

# PostgreSQL local (variaveis usadas pelo docker-compose.yml).
POSTGRES_USER=esports_user
POSTGRES_PASSWORD="SUBSTITUA_POR_UMA_SENHA_FORTE"
POSTGRES_DB=esports_db

# Mantenha usuario, senha e banco consistentes com os valores acima.
# Codifique caracteres especiais da senha para uso em uma URL.
DATABASE_URL="postgresql+asyncpg://esports_user:SUBSTITUA_POR_UMA_SENHA_FORTE@localhost:5432/esports_db"

# Chave obrigatoria da PandaScore.
PANDASCORE_API_KEY="SUBSTITUA_PELA_SUA_CHAVE_PANDASCORE"

# Opcional: lista separada por virgulas. Quando preenchida, substitui a
# chave individual nas chamadas do cliente de sincronizacao.
PANDASCORE_KEYS=""

# Lista JSON de origens web autorizadas. Ajuste para os dominios utilizados.
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
