# Copy to .env for LOCAL development only.
ENVIRONMENT=development
PROJECT_NAME="Esports API"
DATABASE_URL="postgresql+asyncpg://esports:replace-me@localhost:5432/esports_db"
DATABASE_SSL=false
POSTGRES_USER=esports
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=esports_db
PANDASCORE_API_KEY=replace-me
PANDASCORE_KEYS=""
# Generate TWO DIFFERENT keys with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_ACCESS_KEY=""
SECRET_KEY=""
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BACKEND_CORS_ORIGINS=[]
RATE_LIMIT_STORAGE_URI="memory://"
# Production: ENVIRONMENT=production, DATABASE_SSL=true.
# Before scaling beyond one worker: RATE_LIMIT_STORAGE_URI=rediss://user:password@host:port/0
# DATABASE_CA_FILE=/path/to/provider-ca.pem  (if the system CA store is insufficient)
